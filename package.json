{
  "name": "job-portal-management",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/akanandhu/job-portal-management#readme",
  "bugs": {
    "url": "https://github.com/akanandhu/job-portal-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akanandhu/job-portal-management.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "db:init:api": "npm run db:init --workspace=api",
    "seed:api": "npm run seed --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build --workspace=web",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
